# ============================================================
# SHL Assessment Recommender - Environment Variables
# ============================================================

# LLM Provider (choose one: openai, groq, gemini, openrouter)
LLM_PROVIDER=groq

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Groq (if LLM_PROVIDER=groq) - Fast & Free tier available
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-70b-8192

# Google Gemini (if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter (if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=meta-llama/llama-3-70b-instruct

# Embedding provider (openai or local)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Vector DB (faiss or chroma)
VECTOR_DB=faiss
CHROMA_PERSIST_DIR=./data/chroma

# Data paths
CATALOG_JSON_PATH=./data/shl_catalog.json
FAISS_INDEX_PATH=./data/faiss_index

# App settings
MAX_TURNS=8
TOP_K_RETRIEVAL=10
RERANK_TOP_K=5
LOG_LEVEL=INFO

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
